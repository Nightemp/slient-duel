# Токен бота, который выдаёт @BotFather
BOT_TOKEN=123456:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Публичный URL твоего сервиса на Render (после первого деплоя Render сам его выдаст)
# пример: https://silent-duel.onrender.com
APP_URL=https://your-app-name.onrender.com

# Порт (Render сам подставит свой, локально можно оставить 3000)
PORT=3000